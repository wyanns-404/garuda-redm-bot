# ====== DISCORD ======
DISCORD_TOKEN=isi_token_bot_discord_kamu
DISCORD_CLIENT_ID=isi_client_id_bot
# Isi kalau mau slash command langsung update di 1 server (jauh lebih cepat saat development)
DISCORD_GUILD_ID=isi_guild_id_server_discord

# ====== REDM SERVER ======
# IP publik / domain server RedM kamu (tanpa http://)
REDM_SERVER_HOST=127.0.0.1
REDM_SERVER_PORT=30120
REDM_SERVER_NAME=Ashland

# Channel tempat embed status server auto-update dikirim
STATUS_CHANNEL_ID=isi_channel_id
# Interval auto-update status (dalam detik)
STATUS_UPDATE_INTERVAL=60

# ====== AI FAQ BOT (Garuda RedM) ======
# Pilih provider AI: "anthropic" (Claude) atau "gemini"
AI_PROVIDER=anthropic

# Isi kalau AI_PROVIDER=anthropic — dari https://console.anthropic.com
ANTHROPIC_API_KEY=isi_api_key_anthropic
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Isi kalau AI_PROVIDER=gemini — dari https://aistudio.google.com/apikey
GEMINI_API_KEY=isi_api_key_gemini
GEMINI_MODEL=gemini-2.0-flash

# Channel KHUSUS tempat bot menjawab pertanyaan seputar server (di luar channel ini bot diam)
AI_FAQ_CHANNEL_ID=isi_channel_id
# Cooldown per user dalam detik, mencegah spam ke API
AI_FAQ_COOLDOWN_SECONDS=10
