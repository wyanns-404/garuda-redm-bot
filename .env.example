# ====== DISCORD ======
DISCORD_TOKEN=isi_token_bot_discord_kamu
DISCORD_CLIENT_ID=isi_client_id_bot
DISCORD_GUILD_ID=isi_guild_id_server_discord

# ====== FITUR DONASI ======
DONATION_CHANNEL_ID=isi_channel_id
DONATION_LOG_CHANNEL_ID=isi_channel_id

# ====== FITUR UPLOAD GAMBAR (Cloudflare R2) ======
IMAGE_CHANNEL_ID=isi_channel_id
IMAGE_LOG_CHANNEL_ID=isi_channel_id
IMAGE_UPLOAD_ROLE_ID=isi_role_id
IMAGE_WORKER_URL=https://domainmu.com
IMAGE_UPLOAD_SECRET=isi_secret_acak
IMAGE_FILE_PREFIX=WYANNS

# ====== GARUDA API (resource di server RedM, dipakai fitur donasi) ======
# Saklar: true = ON. Selain itu OFF (bot tidak memanggil API, fitur donasi nonaktif)
GARUDA_API_ENABLED=false
GARUDA_API_URL=http://ip_server:port/nama_resource
# Harus sama dengan secret yang di-set di server RedM
GARUDA_API_SECRET=isi_secret_acak

# ====== AI FAQ BOT (Garuda RedM) ======
# Pilih provider AI: "anthropic" (Claude) atau "gemini"
AI_PROVIDER=anthropic
# Isi kalau AI_PROVIDER=anthropic — dari https://console.anthropic.com
ANTHROPIC_API_KEY=isi_api_key_anthropic
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Isi kalau AI_PROVIDER=gemini — dari https://aistudio.google.com/apikey
GEMINI_API_KEY=isi_api_key_gemini
GEMINI_MODEL=gemini-2.0-flash
AI_FAQ_CHANNEL_ID=isi_channel_id
AI_FAQ_COOLDOWN_SECONDS=10